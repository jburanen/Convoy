# Copy to `.env`, or export in your shell / load from a secrets store. Service-
# level settings only — per-host SSH credentials are added in the web UI and
# stored encrypted.
#
# Grouped roughly in the order a deployment needs them. Legacy `CHKP_CPUSE_*`
# names are still read as a fallback; `CONVOY_*` wins.

# --- Core --------------------------------------------------------------------

# Master key for the encrypted credential store, held in memory only. Unset:
# credential/patching endpoints return 503, everything else works.
# CONVOY_MASTER_KEY=changeme

# Image tag docker-compose.yml pulls. Default: latest. Published tags:
# https://github.com/jburanen/Convoy/pkgs/container/convoy
# CONVOY_TAG=1.0.0-rc.1

# Config file path. Unset: built-in defaults.
# CONVOY_CONFIG=./config.yaml

# --- Web UI authentication ----------------------------------------------------
# ON by default: a local admin/admin login unless LDAP (below) is configured,
# which wins wherever both are set. There are no roles — every authenticated
# user has full destructive authority over every environment. Credential storage
# cannot be enabled while auth is off. Failed logins are throttled per username
# and source IP.

# Local login, used only when LDAP is not configured. Default: admin/admin. A
# password changed from the User Settings modal is stored in the database and
# overrides these from then on.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=admin

# Turn local basic auth off. No effect when LDAP is configured. Default: false.
# BASIC_AUTH_DISABLE=false

# Run with NO authentication. Required in addition to BASIC_AUTH_DISABLE=true,
# which alone leaves the login gate up; with no LDAP configured either, this
# exposes every destructive route to anyone who can reach the port. Default: 0.
# CONVOY_ALLOW_NO_AUTH=0

# --- LDAP / Active Directory --------------------------------------------------
# Turns on when BOTH URL and REQUIRED_GROUP are set; a partial config fails
# startup. Every member of the required group gets full destructive authority,
# so scope it accordingly.

# Directory URLs, comma-separated for failover, ldaps:// for TLS.
# CONVOY_LDAP_URL=ldaps://dc1.corp.example.com:636,ldaps://dc2.corp.example.com:636
# Group whose members may sign in (direct memberOf check).
# CONVOY_LDAP_REQUIRED_GROUP=CN=CPUSE-Admins,OU=Groups,DC=corp,DC=example,DC=com

# Service account for search-then-bind. Omit both if using the DN template below.
# CONVOY_LDAP_BIND_DN=CN=svc-cpuse,OU=Service Accounts,DC=corp,DC=example,DC=com
# CONVOY_LDAP_BIND_PASSWORD=changeme
# Bind password from a file (docker secret); the inline var above wins.
# CONVOY_LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password

# Base DN to search (required with a service account).
# CONVOY_LDAP_USER_BASE_DN=OU=Users,DC=corp,DC=example,DC=com
# User search filter; {username} is substituted and escaped. Default is AD's
# sAMAccountName — use (uid={username}) for OpenLDAP/posix directories.
# CONVOY_LDAP_USER_FILTER=(sAMAccountName={username})

# Direct bind instead of a service account; {username} is substituted.
# CONVOY_LDAP_USER_DN_TEMPLATE={username}@corp.example.com

# Attribute holding the user's group DNs. Default: memberOf.
# CONVOY_LDAP_MEMBER_OF_ATTR=memberOf

# StartTLS on a plain ldap:// connection, server cert verification, and a CA
# bundle for a private CA. Defaults: false, true, unset.
# CONVOY_LDAP_START_TLS=false
# CONVOY_LDAP_TLS_VERIFY=true
# CONVOY_LDAP_CA_CERT=/etc/ssl/certs/corp-ca.pem

# --- Sessions -----------------------------------------------------------------

# Idle minutes before auto-logout (also clears tab-cached credentials).
# Default: 30.
# CONVOY_SESSION_IDLE_MINUTES=30

# Secure flag on the session cookie. Defaults to true only when native HTTPS
# (below) is set; set it true explicitly when a reverse proxy terminates TLS.
# Leave it false on plain HTTP — the browser drops a Secure cookie there.
# CONVOY_SESSION_COOKIE_SECURE=true

# --- Native HTTPS (optional) --------------------------------------------------
# Only needed when nothing in front of the container terminates TLS. Both must
# be set together or startup fails, and only `python -m convoy.web` (the
# container's default CMD) reads them. Paths resolve inside the container.
# CONVOY_SSL_CERTFILE=/data/certs/fullchain.pem
# CONVOY_SSL_KEYFILE=/data/certs/privkey.pem

# --- Packages -----------------------------------------------------------------

# Days before an unpinned uploaded package is auto-deleted; 0 disables expiry.
# Overrides package_retention_days in the config file. Default: 30.
# CONVOY_PACKAGE_RETENTION_DAYS=30

# Ceiling on a single package upload, in bytes. Default: 16 GiB. Uploads are
# also refused unless the volume has the incoming size plus 1 GiB free.
# CONVOY_MAX_UPLOAD_BYTES=17179869184

# --- Logging and diagnostics --------------------------------------------------

# Web server and uvicorn log level; any standard Python level name.
# Default: WARNING.
# CONVOY_WEB_LOG_LEVEL=WARNING

# Log every Check Point Management API request and response, redacted, at
# WARNING. Very noisy — troubleshooting only. Default: false.
# CONVOY_LOG_API_CALLS=false

# Disable the footer's "newer release available" check (one cached github.com
# call every few hours). Any value other than 0/false/no/off turns it off.
# CONVOY_DISABLE_UPDATE_CHECK=1
