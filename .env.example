# Example environment file — SAFE TO COMMIT (placeholders only).
# Copy to `.env` (git-ignored) OR export these in your shell / load from a secrets
# store; never commit the real .env. These are service-level settings — per-host
# SSH credentials are NOT set here: add them in the web UI, encrypted at rest.

# NOTE — renamed prefix. This project was called `chkp-cpuse-orch`; every variable
# below moved from `CHKP_CPUSE_*` to `CONVOY_*`. The old names still work and are
# read as a fallback (a warning names the replacement), so an existing deployment
# keeps running without editing its .env. Migrate at your convenience; if both are
# set the `CONVOY_*` value wins.

# Master key for the encrypted credential store. Held in memory only; nothing
# readable lands on the data volume. Without it, credential/patching endpoints
# return 503 and everything else still works. NEVER commit the real value.
# CONVOY_MASTER_KEY=changeme

# Which published image docker-compose.yml pulls. Defaults to `latest`; set a
# release tag to pin one anywhere a redeploy should get the same build back.
# See https://github.com/jburanen/Convoy/pkgs/container/convoy for what exists.
# CONVOY_TAG=1.0.0-rc.1

# Optional: path to a config file (else built-in defaults are used).
# CONVOY_CONFIG=./config.yaml

# Optional: days to keep an uploaded package before it is auto-deleted, unless
# the operator pins it ("Keep") in the web UI. 0 disables auto-expiry entirely.
# Overrides package_retention_days from the config file. Default: 30.
# CONVOY_PACKAGE_RETENTION_DAYS=30
#
# Ceiling on a single package upload, in bytes (default 16 GiB). This exists to
# stop an unbounded or repeated upload filling /data — which also holds the
# database (jobs, sessions, encrypted credentials) and the job archive, so a
# full volume breaks far more than uploads. Raise it only if you genuinely
# handle images larger than this; uploads are also refused when the volume
# lacks the incoming size plus 1 GiB of headroom.
# CONVOY_MAX_UPLOAD_BYTES=17179869184

# --- Web UI authentication (local basic-auth / LDAP / Active Directory) -----
# Auth is ON BY DEFAULT: with nothing set below, the tool is protected by a
# local admin/admin login (see the Basic Auth section further down) — change
# that password on first login, or configure LDAP, or explicitly disable it.
# LDAP takes priority whenever it's configured; basic auth is only used when
# LDAP isn't. Auth is fully OPTIONAL only if you deliberately turn it off with
# BOTH keys (BASIC_AUTH_DISABLE=true AND CONVOY_ALLOW_NO_AUTH=1, no LDAP
# vars) — safe only on a trusted network, and credential storage cannot be
# enabled while auth is off either way.
#
# NOTE ON AUTHORIZATION: there are no roles. EVERY authenticated user has full
# destructive authority over EVERY environment — patch and reboot firewalls,
# bootstrap admin accounts onto gateways, delete environments. Under LDAP that
# means every member of CONVOY_LDAP_REQUIRED_GROUP. Scope that group with
# that in mind. Failed logins are throttled per-username and per-source-IP.
# Auth turns ON when BOTH CONVOY_LDAP_URL and CONVOY_LDAP_REQUIRED_GROUP
# are set; a partial config fails startup rather than silently running open.
#
# Basic auth: a single local username/password, used only when LDAP (below)
# isn't configured. Defaults to admin/admin when unset — change the password
# from the User Settings modal (click your username) after first login; the
# change is persisted in the database and overrides this var from then on.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=admin
#
# Turn basic auth off entirely (e.g. you only ever intend to run without auth,
# or LDAP is mandatory in your environment). Has no effect when LDAP is
# configured — LDAP always wins.
# BASIC_AUTH_DISABLE=false
#
# Running with NO authentication at all takes a second, deliberate key as well.
# On its own, BASIC_AUTH_DISABLE leaves the login gate up and logs a warning:
# it's too easy to set thinking it only relaxes a login prompt, when it in fact
# exposes every destructive route (credential bootstrap onto gateways, CDT
# execute, environment deletion) to anyone who can reach the port. Set this too
# only if that is genuinely what you want.
# CONVOY_ALLOW_NO_AUTH=0
#
# Directory URL(s), comma-separated for failover. Use ldaps:// for TLS.
# CONVOY_LDAP_URL=ldaps://dc1.corp.example.com:636,ldaps://dc2.corp.example.com:636
#
# DN of the group whose members may access the tool (direct memberOf check).
# CONVOY_LDAP_REQUIRED_GROUP=CN=CPUSE-Admins,OU=Groups,DC=corp,DC=example,DC=com
#
# Service account used to look up the user's DN (search-then-bind). Omit BOTH of
# these if you instead use CONVOY_LDAP_USER_DN_TEMPLATE for a direct bind.
# CONVOY_LDAP_BIND_DN=CN=svc-cpuse,OU=Service Accounts,DC=corp,DC=example,DC=com
# CONVOY_LDAP_BIND_PASSWORD=changeme
# Or read the bind password from a file (docker secret); the inline var above
# wins if both are set.
# CONVOY_LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password
#
# Base DN to search for users (required with a service account).
# CONVOY_LDAP_USER_BASE_DN=OU=Users,DC=corp,DC=example,DC=com
# User search filter; {username} is substituted (and escaped). Default is AD's
# sAMAccountName; use e.g. (uid={username}) for OpenLDAP/posix directories.
# CONVOY_LDAP_USER_FILTER=(sAMAccountName={username})
#
# Alternative to a service account: bind directly as the user via a DN template.
# {username} is substituted. Example uses an AD UPN.
# CONVOY_LDAP_USER_DN_TEMPLATE={username}@corp.example.com
#
# Attribute holding the user's group DNs. Default: memberOf.
# CONVOY_LDAP_MEMBER_OF_ATTR=memberOf
#
# TLS: use StartTLS on a plain ldap:// connection, verify the server cert, and
# point at a CA bundle if the directory uses a private CA.
# CONVOY_LDAP_START_TLS=false
# CONVOY_LDAP_TLS_VERIFY=true
# CONVOY_LDAP_CA_CERT=/etc/ssl/certs/corp-ca.pem
#
# Session: idle minutes before auto-logout (also clears tab-cached credentials),
# and whether the session cookie carries the Secure flag. Default idle: 30.
# Secure defaults to true only when native HTTPS (CONVOY_SSL_CERTFILE/
# KEYFILE, below) is configured — otherwise false, since a Secure cookie is
# silently dropped by the browser over plain HTTP (login "succeeds" but every
# request after that looks unauthenticated). Set this to true explicitly if
# TLS is terminated in front of the app instead (a reverse proxy) — the native
# certs are correctly unset here in that case, but the browser still only
# ever sees https.
# CONVOY_SESSION_IDLE_MINUTES=30
# CONVOY_SESSION_COOKIE_SECURE=true

# Web server log level (also applied to uvicorn's own access/error logs) —
# controls what lands in `docker compose logs`. Default: WARNING (routine
# per-request INFO chatter is suppressed). Set DEBUG/INFO for more detail,
# ERROR/CRITICAL for less. One of Python's standard level names.
# CONVOY_WEB_LOG_LEVEL=WARNING

# Log every Check Point Management API request and response (redacted —
# passwords/API keys/session ids are replaced before logging). Off by default:
# this is every API call in full and is noisy; turn on only while
# troubleshooting. Logged at WARNING so it still surfaces under the default
# CONVOY_WEB_LOG_LEVEL above.
# CONVOY_LOG_API_CALLS=false

# --- Native HTTPS (optional) -------------------------------------------------
# Off by default (plain HTTP) — only needed when nothing in front of the
# container (e.g. Nginx/NPM) is already terminating TLS. Only takes effect when
# running via `python -m convoy.web` (the container's default CMD); a
# bare `uvicorn ...` invocation needs its own --ssl-certfile/--ssl-keyfile flags.
# Both vars must be set together or startup fails. Paths are read inside the
# container, so place the files under the bind-mounted ./data volume, e.g.
# ./data/certs/, and point here at /data/certs/....
# CONVOY_SSL_CERTFILE=/data/certs/fullchain.pem
# CONVOY_SSL_KEYFILE=/data/certs/privkey.pem
